{
  "mcpServers": {
    "unifi": {
      "command": "python",
      "args": ["-m", "unifi_mcp"],
      "env": {
        "UNIFI_HOST": "YOUR_CONTROLLER_IP",
        "UNIFI_API_KEY": "YOUR_API_KEY",
        "UNIFI_SITE": "default",
        "UNIFI_VERIFY_SSL": "false",
        "LOG_LEVEL": "INFO"
      },
      "disabled": false,
      "autoApprove": [
        "unifi_list_*",
        "unifi_get_*"
      ]
    }
  }
}
