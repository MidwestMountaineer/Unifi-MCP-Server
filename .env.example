# UniFi Network Controller Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# UniFi Controller Connection
UNIFI_HOST=192.168.1.1
UNIFI_PORT=443
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# Authentication Method 1: API Key (Recommended for UniFi OS)
# Generate an API key in UniFi OS Console: Settings > Admins & Users > API
# If using API key, you don't need username/password
UNIFI_API_KEY=your-api-key-here

# Authentication Method 2: Username/Password (Traditional)
# Use this if you don't have UniFi OS or prefer session-based auth
# If using username/password, leave UNIFI_API_KEY empty
UNIFI_USERNAME=your-username-here
UNIFI_PASSWORD=your-password-here

# Logging Configuration (Optional)
LOG_LEVEL=INFO
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR

# Development/Debugging (Optional)
# UNIFI_DEBUG=false
