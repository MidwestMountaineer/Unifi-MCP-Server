# UniFi MCP Server - Docker Ignore File
# Excludes unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment files (NEVER include in image)
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in runtime image)
docs/
examples/
devtools/
tests/
*.md
!README.md

# CI/CD
.github/
.gitlab-ci.yml

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Project-specific
demo.py
DEMO_SUMMARY.md
BUGFIX-SUMMARY.md
KIRO-CONFIG-FIX.md
PROJECT-SETUP.md
TEST-STARTUP.md
TOOL-REGISTRATION-FIX.md
